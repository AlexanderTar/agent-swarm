{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "swarm": {
      "type": "stdio",
      "command": "node",
      "args": [
        "bin/swarm-mcp.mjs"
      ],
      "env": {
        "SWARM_URL": "http://127.0.0.1:7777",
        "SWARM_REGISTER_SESSION": "0"
      }
    }
  }
}
